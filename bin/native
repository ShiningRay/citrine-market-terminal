#!/usr/bin/env ruby
# frozen_string_literal: true

# 原生窗口启动器：和 bin/dev 同一个仓库、同一棵组件树，只是换渲染目标。
#
#   bin/native
#
# 与 bin/dev 的差别：
#   · 不需要 Opal / Node——直接在本机 CRuby 上跑（libui 经 citrine-native 的 Fiddle 绑定加载）
#   · 路径约定一致：CITRINE_ROOT 指 citrine 仓库；citrine-native 默认取其同级目录，
#     可用 CITRINE_NATIVE_ROOT 覆盖
#
# 起来之前先确认两条（否则窗口不会出现）：
#   1. Ruby 是装了 libui 的那个（本机是 asdf 的 3.4.8：`export PATH="$HOME/.asdf/shims:$PATH"`）
#   2. citrine-native 已落地自绘面板能力（area）——见其 docs/plan/analysis/demos-native.md 的 NA-1
root = File.expand_path("..", __dir__)
citrine_root = ENV["CITRINE_ROOT"] || File.expand_path("../citrine", root)
native_root = ENV["CITRINE_NATIVE_ROOT"] || File.expand_path("../citrine-native", root)

missing = { "citrine" => citrine_root, "citrine-native" => native_root }
          .reject { |_name, dir| File.directory?(File.join(dir, "lib")) }
unless missing.empty?
  abort <<~MSG
    找不到依赖仓库（缺 lib/ 目录）：#{missing.map { |name, dir| "#{name}=#{dir}" }.join(' ')}
    请把 citrine / citrine-native 与本仓库放在同一父目录下，或设置：
      export CITRINE_ROOT=/path/to/citrine
      export CITRINE_NATIVE_ROOT=/path/to/citrine-native
  MSG
end

$LOAD_PATH.unshift(File.join(root, "app"), File.join(citrine_root, "lib"), File.join(native_root, "lib"))

require "citrine-native-libui"
require_relative "../native/app"

# 退出路径：**先退出主循环，再拆解**（MARKET-1d）。
#
# 为什么必须自己接信号：`Citrine::Native.run` 把 teardown 放在 ensure 里，而 Ruby 对
# 未捕获的终止信号（SIGINT/SIGTERM/…）是**直接终止进程**、不跑 ensure——于是 libui
# 的窗口/控件被系统回收，而"每个控件由谁销毁"这套记账（框架的 dispose → uiControlDestroy）
# 完全没走。反过来，若信号恰好落在 Ruby 代码段（例如 200ms 一次的心跳回调里），
# Ruby 会开始展开栈并跑 teardown，此时**在强杀下执行 libui 的析构是不安全的**
# （MARKET-2b §9 F5：`dispose → box_delete` 段错误；本轮改前实测 3 次里 0 次复现，
# 但那次记录说明"拆解真的跑起来"才是危险的那条分支）。
#
# 信号注册现在由框架提供（`App#trap_quit!`，E3）：只在本平台实际存在的信号上装
# （Windows 没有 HUP/QUIT/ALRM，直接 `trap` 会 ArgumentError），装上之后
#   · uiQuit 本身线程安全；trap 在主线程的安全点执行，主循环里 200ms 一次的心跳回调
#     就是那个安全点，所以 Ctrl+C 之后最多 200ms 就走出主循环；
#   · SIGKILL 不可捕获，进程直接消失（不走析构，也不会踩析构）——这已是唯一一条
#     "绕过拆解"的路径，实测 3/3 干净（见 native/README.md 的退出路径一节）。
app = Citrine::Native.start(Market::Native::Terminal, **Market::Native::Terminal::WINDOW)
app.trap_quit!
app.widgets.main_loop
app.teardown

